{
  "info": {
    "name": "Matjar API",
    "description": "E-commerce backend. Run Register/Login first to capture tokens.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000/api/v1" },
    { "key": "customerToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "categoryId", "value": "" },
    { "key": "productId", "value": "" },
    { "key": "productSlug", "value": "" },
    { "key": "addressId", "value": "" },
    { "key": "cartItemId", "value": "" },
    { "key": "orderId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\": \"customer@matjar.local\", \"password\": \"Secret123!\", \"name\": \"Customer\"}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["const j = pm.response.json();", "pm.collectionVariables.set(\"customerToken\", j.data.accessToken);"] } }]
        },
        {
          "name": "Login customer",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\": \"customer@matjar.local\", \"password\": \"Secret123!\"}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["const j = pm.response.json();", "pm.collectionVariables.set(\"customerToken\", j.data.accessToken);"] } }]
        },
        {
          "name": "Login admin",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\": \"admin@matjar.local\", \"password\": \"Admin123!\"}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["const j = pm.response.json();", "pm.collectionVariables.set(\"adminToken\", j.data.accessToken);"] } }]
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/refresh",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"refreshToken\": \"PASTE_REFRESH_TOKEN\"}" }
          }
        },
        {
          "name": "Get me",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users/me",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }]
          }
        }
      ]
    },
    {
      "name": "Catalog (admin)",
      "item": [
        {
          "name": "Create category",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/admin/categories",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"name\": \"Electronics\"}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["const j = pm.response.json();", "if (j.data) pm.collectionVariables.set(\"categoryId\", j.data.id);"] } }]
        },
        {
          "name": "Create product",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/admin/products",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"title\": \"Wireless Headphones\", \"price\": 199.99, \"stockQty\": 50, \"categoryId\": \"{{categoryId}}\"}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["const j = pm.response.json();", "if (j.data) { pm.collectionVariables.set(\"productId\", j.data.id); pm.collectionVariables.set(\"productSlug\", j.data.slug); }"] } }]
        },
        {
          "name": "List products (public)",
          "request": { "method": "GET", "url": "{{baseUrl}}/products?search=headphones&sort=price_asc&page=1&limit=20" }
        },
        {
          "name": "Product detail (public)",
          "request": { "method": "GET", "url": "{{baseUrl}}/products/{{productSlug}}" }
        }
      ]
    },
    {
      "name": "Shop flow",
      "item": [
        {
          "name": "Add address",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/addresses",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"label\": \"home\", \"street\": \"1 Main St\", \"city\": \"Riyadh\", \"country\": \"SA\", \"isDefault\": true}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["const j = pm.response.json();", "if (j.data) pm.collectionVariables.set(\"addressId\", j.data.id);"] } }]
        },
        {
          "name": "Add to cart",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/cart/items",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"productId\": \"{{productId}}\", \"quantity\": 2}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["const j = pm.response.json();", "if (j.data && j.data.items && j.data.items[0]) pm.collectionVariables.set(\"cartItemId\", j.data.items[0].id);"] } }]
        },
        {
          "name": "Get cart",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/cart",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }]
          }
        },
        {
          "name": "Checkout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/orders/checkout",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"addressId\": \"{{addressId}}\", \"shippingCost\": 10}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["const j = pm.response.json();", "if (j.data) pm.collectionVariables.set(\"orderId\", j.data.id);"] } }]
        },
        {
          "name": "My orders",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/orders",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }]
          }
        },
        {
          "name": "Review product",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/products/{{productId}}/reviews",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"rating\": 5, \"comment\": \"Excellent!\"}" }
          }
        }
      ]
    },
    {
      "name": "Admin ops",
      "item": [
        {
          "name": "Dashboard",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/dashboard",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        },
        {
          "name": "List orders",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/orders?status=PENDING",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        },
        {
          "name": "Mark order PAID",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/admin/orders/{{orderId}}/status",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"status\": \"PAID\"}" }
          }
        }
      ]
    }
  ]
}

